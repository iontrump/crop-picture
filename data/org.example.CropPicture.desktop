[Desktop Entry]
Name=Crop Picture
GenericName=Image Cropper
Comment=Crop custom-size images from photos and illustrations for web
Exec=crop-picture %U
Icon=org.example.CropPicture
Terminal=false
Type=Application
Categories=GNOME;GTK;Graphics;Photography;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;
StartupNotify=true
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=crop-picture

